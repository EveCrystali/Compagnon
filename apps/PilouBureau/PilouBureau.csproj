<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>PilouBureau</RootNamespace>
    <AssemblyName>PilouBureau</AssemblyName>
    <Version>0.8.0</Version>
    <!-- Le Gestionnaire des tâches affiche la description du fichier (AssemblyTitle) et l'icône de l'exe. -->
    <AssemblyTitle>Pilou</AssemblyTitle>
    <Product>Pilou</Product>
    <Company>Pilou</Company>
    <ApplicationIcon>pilou.ico</ApplicationIcon>
    <Description>Pilou, petit compagnon de bureau qui vit en bas de ton écran et grandit avec toi.</Description>
    <SatelliteResourceLanguages>fr</SatelliteResourceLanguages>
  </PropertyGroup>

  <!-- Option -p:IdentitePackage=true : version qui lit les notifications Windows (docs/NOTIFICATIONS.md). Windows
       réserve cette lecture (UserNotificationListener) aux applis qui ont une identité de package : cette version
       embarque le manifeste qui relie l'exe au package d'identité (identite/) et les projections WinRT du SDK
       Windows 10 (2004), environ 25 Mo de plus. Non utilisée par défaut : sans identité, elle ne lirait rien. -->
  <PropertyGroup Condition="'$(IdentitePackage)' == 'true'">
    <TargetFramework>net9.0-windows10.0.19041.0</TargetFramework>
    <ApplicationManifest>identite\PilouBureau.identite.manifest</ApplicationManifest>
    <DefineConstants>$(DefineConstants);LECTEUR_NOTIFS</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="tests\**" />
  </ItemGroup>

  <ItemGroup>
    <!-- Banque de sprites commune avec l'app Android (assets/ à la racine du dépôt), embarquée dans l'exécutable. -->
    <EmbeddedResource Include="..\..\assets\sprites\*.txt" LogicalName="sprite:%(Filename)" />
    <EmbeddedResource Include="..\..\assets\*.txt" LogicalName="pilou:%(Filename)%(Extension)" />
    <!-- Campagnes (docs/CAMPAGNES.md) : assets/campagnes/<id>/*.json, communes avec l'app Android. -->
    <EmbeddedResource Include="..\..\assets\campagnes\**\*.json" LogicalName="campagne:%(RecursiveDir)%(Filename)%(Extension)" />
    <!-- Règles d'activités par défaut (la personne peut les compléter dans ~/.claude/compagnon/activites.json). -->
    <EmbeddedResource Include="activites.json" LogicalName="PilouBureau.activites.json" />
    <!-- Icône de Pilou (16 à 48 px), tirée de son rendu (Icone.cs) : zone de notification. -->
    <EmbeddedResource Include="pilou.ico" LogicalName="pilou:icone.ico" />
  </ItemGroup>

  <ItemGroup>
    <!-- QR code d'appairage du téléphone (pur C#, sans dépendance native). -->
    <PackageReference Include="QRCoder" Version="1.6.0" />
    <!-- Secrets des connecteurs chiffrés par DPAPI (compte Windows courant). -->
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="9.0.0" />
  </ItemGroup>

</Project>
