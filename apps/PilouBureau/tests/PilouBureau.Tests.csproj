<Project Sdk="Microsoft.NET.Sdk">

  <!-- Logique sans WPF (états, bulle, signaux, branchements) : tourne sur n'importe quel OS. -->
  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="../Placement.cs;../Etats.cs;../Statut.cs;../Signal.cs;../Integrations.cs;../Telephone.cs;../Mise.cs;../Butin.cs;../Recompenses.cs;../Reglages.cs;../Profil.cs;../Groupe.cs;../Boutique.cs;../Quetes.cs;../Progression.cs;../Activites.cs;../Metiers.cs;../Sprites.cs;../RenduPilou.cs;../Vie.cs;../Meteo.cs;../Connecteurs.cs;../ApiLocale.cs;../Diagnostics.cs;../../../integrations/visualstudio/Rapport.cs;../Connecteurs/*.cs;../Soins.cs;../Expeditions.cs;../Amis.cs;../Gestes.cs;../Notifications.cs;../Vivacite.cs;../Clics.cs;../Icone.cs;../Instance.cs;../MenuNotification.cs;../Tournage.cs;../Police.cs;../PolicePixel.cs;../Flottants.cs;../Defense.cs;../DessinDefense.cs;../Campagnes.cs;../Aventure.cs;../Epreuves.cs;../Presence.cs;../EtatPresence.cs;../AnimationsCampagne.cs;../Theatre.cs;../HabitBouton.cs;../Sons.cs;../PlanMenu.cs;../PremiereMinute.cs" />
    <EmbeddedResource Include="../activites.json" LogicalName="PilouBureau.activites.json" />
    <EmbeddedResource Include="../../../assets/catalogue.txt" LogicalName="pilou:catalogue.txt" />
    <EmbeddedResource Include="../../../assets/presence/*.txt" LogicalName="presence:%(Filename)%(Extension)" />
    <EmbeddedResource Include="../../../assets/police/*.txt" LogicalName="police:%(Filename)%(Extension)" />
    <EmbeddedResource Include="../../../assets/campagnes/**/*.json" LogicalName="campagne:%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.12.0" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="9.0.0" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
  </ItemGroup>

</Project>
