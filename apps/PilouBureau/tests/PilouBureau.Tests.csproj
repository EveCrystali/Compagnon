<Project Sdk="Microsoft.NET.Sdk">

  <!-- Logique sans WPF (états, bulle, signaux, branchements) : tourne sur n'importe quel OS. -->
  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="../Etats.cs;../Statut.cs;../Signal.cs;../Integrations.cs;../Telephone.cs;../Mise.cs;../Butin.cs;../Recompenses.cs;../Reglages.cs;../Profil.cs;../Groupe.cs;../Boutique.cs;../Quetes.cs;../Progression.cs;../Activites.cs;../Metiers.cs;../Sprites.cs;../RenduPilou.cs;../Meteo.cs;../Connecteurs.cs;../ApiLocale.cs;../Connecteurs/*.cs;../Soins.cs;../Amis.cs;../Gestes.cs;../Notifications.cs;../Vivacite.cs" />
    <EmbeddedResource Include="../activites.json" LogicalName="PilouBureau.activites.json" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.12.0" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="9.0.0" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
  </ItemGroup>

</Project>
