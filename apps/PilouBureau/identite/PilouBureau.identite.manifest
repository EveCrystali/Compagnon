<?xml version="1.0" encoding="utf-8"?>
<!--
  Manifeste d'application qui relie PilouBureau.exe au package d'identité (identite/AppxManifest.xml).
  Utilisé seulement avec : dotnet publish ... -p:IdentitePackage=true (voir docs/NOTIFICATIONS.md).
  publisher, packageName et applicationId doivent être identiques à ceux de AppxManifest.xml.
-->
<assembly manifestVersion="1.0" xmlns="urn:schemas-microsoft-com:asm.v1">
  <assemblyIdentity version="1.0.0.0" name="PilouBureau" />
  <msix xmlns="urn:schemas-microsoft-com:msix.v1"
        publisher="CN=PilouLocal"
        packageName="PilouBureau.Identite"
        applicationId="PilouBureau" />
  <trustInfo xmlns="urn:schemas-microsoft-com:asm.v2">
    <security>
      <requestedPrivileges xmlns="urn:schemas-microsoft-com:asm.v3">
        <requestedExecutionLevel level="asInvoker" uiAccess="false" />
      </requestedPrivileges>
    </security>
  </trustInfo>
  <compatibility xmlns="urn:schemas-microsoft-com:compatibility.v1">
    <application>
      <supportedOS Id="{8e0f7a12-bfb3-4fe8-b9a5-48fd50a15a9a}" />
    </application>
  </compatibility>
</assembly>
